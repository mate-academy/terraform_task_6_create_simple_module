# Local Terraform directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan
*.tfplan.*

# Terraform lock file (optional for module repos)
.terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# CLI config files
.terraformrc
terraform.rc
